layout(local_size_x = 64) in;

layout(std430, binding = 0) buffer Nodes {
    float nodes[];
};

layout(std430, binding = 1) buffer Auxiliary {
    float aux[];
};

layout(push_constant) uniform PushConstants {
    int mode;
    int target;
    int count;
    int padding;
    float viewWidth;
    float viewHeight;
    int queryNode;
    float queryX;
    float queryY;
    float scrollX;
    float scrollY;
} push;

float nodeValue(int index, int field) {
    return nodes[index * NODE_FIELD_COUNT + field];
}

void setNodeValue(int index, int field, float value) {
    nodes[index * NODE_FIELD_COUNT + field] = value;
}

int nodeInt(int index, int field) {
    return int(round(nodeValue(index, field)));
}

int nodeFlags(int index) {
    return int(nodes[index * NODE_FIELD_COUNT + F_FLAGS2]) +
        int(nodes[index * NODE_FIELD_COUNT + F_FLAGS3]) * 65536;
}

float nonNegative(float value) {
    return value < 0.0 ? 0.0 : value;
}

float collapseMargin(float first, float second) {
    float positive = max(max(first, second), 0.0);
    float negative = min(min(first, second), 0.0);
    return positive + negative;
}

float inlineLineWidthFrom(int first, float contentWidth, bool wrap) {
    float width = 0.0;
    bool firstRun = true;
    int child = first;
    while (child >= 0) {
        if ((nodeFlags(child) & FLAG_OUT_OF_FLOW) != 0) {
            child = nodeInt(child, F_NEXT);
            continue;
        }
        if (nodeValue(child, F_FORCE_BREAK) > 0.5) {
            break;
        }
        float space = (!firstRun && nodeValue(child, F_SPACE_BEFORE) > 0.5) ?
            nodeValue(child, F_FONT) * 0.25 : 0.0;
        float advance = nodeValue(child, F_ML) + nodeValue(child, F_W) + nodeValue(child, F_MR);
        if (wrap && !firstRun && width + space + advance > contentWidth + 6.0) {
            break;
        }
        width += space + advance;
        firstRun = false;
        child = nodeInt(child, F_NEXT);
    }
    return width;
}

float inlineAlignOffset(int textAlign, float contentWidth, float lineWidth) {
    float remaining = contentWidth - lineWidth;
    if (remaining <= 0.0) {
        return 0.0;
    }
    if (textAlign == 1) {
        return remaining * 0.5;
    }
    if (textAlign == 2) {
        return remaining;
    }
    return 0.0;
}


bool tableRowNode(int node) {
    return (nodeFlags(node) & FLAG_TABLE_ROW) != 0;
}

bool tableGroupNode(int node) {
    return (nodeFlags(node) & FLAG_TABLE_ROW_GROUP) != 0;
}

bool tableCellNode(int node) {
    return (nodeFlags(node) & FLAG_TABLE_CELL) != 0;
}

bool parentFlexOrGrid(int node) {
    int parent = nodeInt(node, F_PARENT);
    if (parent < 0) {
        return false;
    }
    return (nodeFlags(parent) & (FLAG_FLEX_CONTAINER | FLAG_GRID_CONTAINER)) != 0;
}

float flexBase(int child, bool column, float mainSize) {
    int mode = nodeInt(child, F_FLEX_BASIS_MODE);
    float value = nodeValue(child, F_FLEX_BASIS);
    if (mode == 1) {
        return value;
    }
    if (mode == 2) {
        return mainSize * value * 0.01 + nodeValue(child, F_FLEX_BASIS_OFFSET);
    }
    if (column) {
        int heightMode = nodeInt(child, F_MODE_H);
        if (heightMode == 1) {
            return nodeValue(child, F_SPEC_H);
        }
        if (heightMode == 2) {
            return nodeValue(child, F_CH) * nodeValue(child, F_SPEC_H) * 0.01 + nodeValue(child, F_SPEC_H_OFFSET);
        }
        return 0.0;
    }
    int widthMode = nodeInt(child, F_MODE_W);
    if (widthMode == 1) {
        return nodeValue(child, F_SPEC_W);
    }
    if (widthMode == 2) {
        return mainSize * nodeValue(child, F_SPEC_W) * 0.01 + nodeValue(child, F_SPEC_W_OFFSET);
    }
    return nodeValue(child, F_IMAX);
}

float resolveLength(int index, int modeField, int valueField, float base) {
    int mode = nodeInt(index, modeField);
    float value = nodeValue(index, valueField);
    if (mode == 1) {
        return base * value * 0.01;
    }
    if (mode == 2) {
        return 0.0;
    }
    return value;
}


void shiftSubtree(int root, float deltaX, float deltaY) {
    int last = root + max(0, nodeInt(root, F_SUBTREE_SIZE));
    for (int node = root + 1; node < last; node++) {
        setNodeValue(node, F_X, nodeValue(node, F_X) + deltaX);
        setNodeValue(node, F_Y, nodeValue(node, F_Y) + deltaY);
        setNodeValue(node, F_CX, nodeValue(node, F_CX) + deltaX);
        setNodeValue(node, F_CY, nodeValue(node, F_CY) + deltaY);
    }
}

void main() {
    int index = int(gl_GlobalInvocationID.x);
    if (push.padding >= 0) {
        if (index >= push.count) {
            return;
        }
        index = int(aux[push.padding + index]);
    } else if (index >= push.count) {
        return;
    }
    if (nodeInt(index, F_DEPTH) != push.target) {
        return;
    }
    if (push.mode == 0) {
        int kind = nodeInt(index, F_KIND);
        int flags = nodeInt(index, F_FLAGS);
        float intrinsicMin = 0.0;
        float intrinsicMax = 0.0;
        float intrinsicHeight = 0.0;
        if (kind == 2) {
            intrinsicMin = nodeValue(index, F_WORD_W);
            intrinsicMax = nodeValue(index, F_TEXT_W);
            intrinsicHeight = nodeValue(index, F_LINE);
        } else if ((flags & FLAG_REPLACED) != 0) {
            intrinsicMin = nodeValue(index, F_REPL_W);
            intrinsicMax = intrinsicMin;
            intrinsicHeight = nodeValue(index, F_REPL_H);
        } else {
            bool inlineContainer = (nodeFlags(index) & FLAG_INLINE_CONTAINER) != 0;
            int child = nodeInt(index, F_FIRST);
            float totalHeight = 0.0;
            float maximumHeight = 0.0;
            while (child >= 0) {
                float childMin = nodeValue(child, F_IMIN);
                float childMax = nodeValue(child, F_IMAX);
                if (childMin > intrinsicMin) {
                    intrinsicMin = childMin;
                }
                if (inlineContainer) {
                    if (nodeValue(child, F_SPACE_BEFORE) > 0.5) {
                        intrinsicMax += nodeValue(child, F_FONT) * 0.25;
                    }
                    intrinsicMax += childMax + nodeValue(child, F_ML) + nodeValue(child, F_MR);
                } else if (childMax > intrinsicMax) {
                    intrinsicMax = childMax;
                }
                float childHeight = nodeValue(child, F_IHEIGHT) +
                    nodeValue(child, F_MT) + nodeValue(child, F_MB) +
                    nodeValue(child, F_PT) + nodeValue(child, F_PB) +
                    nodeValue(child, F_BT) + nodeValue(child, F_BB);
                totalHeight += childHeight;
                if (childHeight > maximumHeight) {
                    maximumHeight = childHeight;
                }
                child = nodeInt(child, F_NEXT);
            }
            intrinsicHeight = inlineContainer ? maximumHeight : totalHeight;
        }
        int widthMode = nodeInt(index, F_MODE_W);
        float specifiedWidth = nodeValue(index, F_SPEC_W);
        if (widthMode == 1) {
            intrinsicMin = specifiedWidth;
            intrinsicMax = specifiedWidth;
        } else if (widthMode == 2) {
            intrinsicMin = specifiedWidth;
            intrinsicMax = specifiedWidth;
        }
        setNodeValue(index, F_IMIN, intrinsicMin);
        setNodeValue(index, F_IMAX, intrinsicMax);
        setNodeValue(index, F_IHEIGHT, intrinsicHeight);
        return;
    }

    if (push.mode == 5) {
        int flags = nodeFlags(index);
        if ((flags & FLAG_BLOCK_CONTAINER) == 0) {
            setNodeValue(index, F_COLLAPSE_TOP, nodeValue(index, F_MT));
            return;
        }
        float rawTop = nodeValue(index, F_MT);
        float top = rawTop;
        int firstChild = nodeInt(index, F_FIRST);
        if (!parentFlexOrGrid(index) && (flags & FLAG_BLOCK_FORMATTING) == 0 && firstChild >= 0 &&
            nodeValue(index, F_BT) + nodeValue(index, F_PT) == 0.0) {
            int childKind = nodeInt(firstChild, F_KIND);
            if (childKind == 0) {
                float childTop = nodeValue(firstChild, F_MT);
                float collapsed = collapseMargin(rawTop, childTop);
                if (collapsed != top) {
                    top = collapsed;
                    setNodeValue(index, F_FLAGS2, float(flags | FLAG_COLLAPSED_FIRST));
                }
            }
        }
        setNodeValue(index, F_COLLAPSE_TOP, top);
        return;
    }


    if (push.mode == 6) {
        int flags = nodeFlags(index);
        if ((flags & FLAG_GRID_CONTAINER) == 0) {
            return;
        }
        int maxColumns = int(nodeValue(index, F_GRID_MAX_COLS));
        int maxRows = int(nodeValue(index, F_GRID_MAX_ROWS));
        int scratch = int(nodeValue(index, F_GRID_SCRATCH_START));
        int columnBase = scratch;
        int rowBase = scratch + maxColumns;
        int occupancyBase = scratch + maxColumns + maxRows;
        int columnTrackStart = int(nodeValue(index, F_COL_TRACK_START));
        int columnTrackCount = int(nodeValue(index, F_COL_TRACK_COUNT));
        int rowTrackStart = int(nodeValue(index, F_ROW_TRACK_START));
        int rowTrackCount = int(nodeValue(index, F_ROW_TRACK_COUNT));
        float columnGap = nodeValue(index, F_COL_GAP);
        float rowGap = nodeValue(index, F_ROW_GAP);
        int columnCount = max(columnTrackCount, 1);
        int rowCount = max(rowTrackCount, 1);

        for (int cell = 0; cell < maxColumns * maxRows; cell++) {
            aux[occupancyBase + cell] = 0.0;
        }
        int total = 0;
        int child = nodeInt(index, F_FIRST);
        while (child >= 0) {
            setNodeValue(child, F_DIRTY, 0.0);
            total++;
            child = nodeInt(child, F_NEXT);
        }

        int placed = 0;
        while (placed < total) {
            int best = -1;
            float bestExplicit = -1.0;
            float bestOrder = 0.0;
            child = nodeInt(index, F_FIRST);
            while (child >= 0) {
                if (nodeInt(child, F_DIRTY) == 0) {
                    float explicit = nodeValue(child, F_GRID_EXPLICIT);
                    float order = nodeValue(child, F_GRID_ORDER);
                    bool better = best < 0;
                    if (!better && explicit > bestExplicit) {
                        better = true;
                    } else if (!better && explicit == bestExplicit) {
                        if (order < bestOrder || (order == bestOrder && child < best)) {
                            better = true;
                        }
                    }
                    if (better) {
                        best = child;
                        bestExplicit = explicit;
                        bestOrder = order;
                    }
                }
                child = nodeInt(child, F_NEXT);
            }
            if (best < 0) {
                break;
            }
            setNodeValue(best, F_DIRTY, 1.0);
            int columnSpan = max(1, int(nodeValue(best, F_GRID_COL_SPAN)));
            int rowSpan = max(1, int(nodeValue(best, F_GRID_ROW_SPAN)));
            int column = 0;
            int row = 0;
            if (bestExplicit > 0.5) {
                int start = int(nodeValue(best, F_GRID_COL_START));
                if (start > 0) {
                    column = start - 1;
                }
                start = int(nodeValue(best, F_GRID_ROW_START));
                if (start > 0) {
                    row = start - 1;
                }
                column = max(column, 0);
                row = max(row, 0);
            } else {
                while (true) {
                    if (column + columnSpan > columnCount) {
                        row++;
                        column = 0;
                        continue;
                    }
                    bool free = true;
                    for (int rr = row; rr < row + rowSpan; rr++) {
                        for (int cc = column; cc < column + columnSpan; cc++) {
                            if (rr < maxRows && cc < maxColumns && aux[occupancyBase + rr * maxColumns + cc] > 0.5) {
                                free = false;
                            }
                        }
                    }
                    if (free) {
                        break;
                    }
                    column++;
                }
            }
            columnCount = max(columnCount, column + columnSpan);
            rowCount = max(rowCount, row + rowSpan);
            for (int rr = row; rr < row + rowSpan; rr++) {
                for (int cc = column; cc < column + columnSpan; cc++) {
                    if (rr < maxRows && cc < maxColumns) {
                        aux[occupancyBase + rr * maxColumns + cc] = 1.0;
                    }
                }
            }
            setNodeValue(best, F_GRID_PLACED_COL, float(column));
            setNodeValue(best, F_GRID_PLACED_ROW, float(row));
            placed++;
        }

        for (int column = 0; column < maxColumns; column++) {
            aux[columnBase + column] = 0.0;
        }
        child = nodeInt(index, F_FIRST);
        while (child >= 0) {
            int column = int(nodeValue(child, F_GRID_PLACED_COL));
            int span = max(1, int(nodeValue(child, F_GRID_COL_SPAN)));
            if (span <= 1 && column >= 0 && column < maxColumns) {
                float extra = nodeValue(child, F_PL) + nodeValue(child, F_PR) +
                    nodeValue(child, F_BL) + nodeValue(child, F_BR) +
                    nodeValue(child, F_ML) + nodeValue(child, F_MR);
                float width = nodeValue(child, F_IMAX) + extra;
                if (width > aux[columnBase + column]) {
                    aux[columnBase + column] = width;
                }
            }
            child = nodeInt(child, F_NEXT);
        }
        float fixedColumns = 0.0;
        float flexColumns = 0.0;
        int autoColumns = 0;
        for (int column = 0; column < columnCount; column++) {
            float kind = 3.0;
            float value = 0.0;
            float flex = 0.0;
            float minimum = 0.0;
            if (column < columnTrackCount) {
                int base = columnTrackStart + column * 8;
                kind = aux[base];
                value = aux[base + 1];
                flex = aux[base + 2];
                minimum = aux[base + 3];
            }
            if (kind > 2.5) {
                autoColumns++;
            } else if (kind > 1.5) {
                flexColumns += flex;
            } else {
                float width = kind > 0.5 ? nodeValue(index, F_CW) * value * 0.01 : value;
                width = max(width, minimum);
                aux[columnBase + column] = width;
                fixedColumns += width;
            }
        }
        float columnFree = nodeValue(index, F_CW) - fixedColumns - columnGap * float(columnCount - 1);
        if (columnFree < 0.0) {
            columnFree = 0.0;
        }
        if (flexColumns > 0.0) {
            for (int column = 0; column < columnCount; column++) {
                float kind = column < columnTrackCount ? aux[columnTrackStart + column * 8] : 3.0;
                if (kind > 1.5 && kind < 2.5) {
                    int base = columnTrackStart + column * 8;
                    float width = max(aux[base + 3], columnFree * aux[base + 2] / flexColumns);
                    aux[columnBase + column] = width;
                }
            }
        } else if (autoColumns > 0) {
            for (int column = 0; column < columnCount; column++) {
                float kind = column < columnTrackCount ? aux[columnTrackStart + column * 8] : 3.0;
                if (kind > 2.5) {
                    float width = aux[columnBase + column];
                    if (width <= 0.0) {
                        width = columnFree / float(autoColumns);
                    }
                    aux[columnBase + column] = width;
                }
            }
        }

        for (int row = 0; row < maxRows; row++) {
            aux[rowBase + row] = 0.0;
        }
        child = nodeInt(index, F_FIRST);
        while (child >= 0) {
            int row = int(nodeValue(child, F_GRID_PLACED_ROW));
            int span = max(1, int(nodeValue(child, F_GRID_ROW_SPAN)));
            if (span <= 1 && row >= 0 && row < maxRows) {
                if (nodeValue(child, F_H) > aux[rowBase + row]) {
                    aux[rowBase + row] = nodeValue(child, F_H);
                }
            }
            child = nodeInt(child, F_NEXT);
        }
        float fixedRows = 0.0;
        float flexRows = 0.0;
        int autoRows = 0;
        for (int row = 0; row < rowCount; row++) {
            float kind = 3.0;
            float value = 0.0;
            float flex = 0.0;
            float minimum = 0.0;
            if (row < rowTrackCount) {
                int base = rowTrackStart + row * 8;
                kind = aux[base];
                value = aux[base + 1];
                flex = aux[base + 2];
                minimum = aux[base + 3];
            }
            if (kind > 2.5) {
                autoRows++;
            } else if (kind > 1.5) {
                flexRows += flex;
            } else {
                float height = kind > 0.5 ? nodeValue(index, F_CH) * value * 0.01 : value;
                height = max(height, minimum);
                aux[rowBase + row] = height;
                fixedRows += height;
            }
        }
        float rowFree = nodeValue(index, F_CH) - fixedRows - rowGap * float(rowCount - 1);
        if (rowFree < 0.0) {
            rowFree = 0.0;
        }
        if (flexRows > 0.0) {
            for (int row = 0; row < rowCount; row++) {
                float kind = row < rowTrackCount ? aux[rowTrackStart + row * 8] : 3.0;
                if (kind > 1.5 && kind < 2.5) {
                    int base = rowTrackStart + row * 8;
                    float height = max(aux[base + 3], rowFree * aux[base + 2] / flexRows);
                    aux[rowBase + row] = height;
                }
            }
        } else if (autoRows > 0) {
            for (int row = 0; row < rowCount; row++) {
                float kind = row < rowTrackCount ? aux[rowTrackStart + row * 8] : 3.0;
                if (kind > 2.5) {
                    float height = aux[rowBase + row];
                    if (height <= 0.0) {
                        height = rowFree / float(autoRows);
                    }
                    aux[rowBase + row] = height;
                }
            }
        }

        int containerJustify = int(nodeValue(index, F_GRID_JUSTIFY));
        int containerAlign = int(nodeValue(index, F_GRID_ALIGN));
        child = nodeInt(index, F_FIRST);
        while (child >= 0) {
            int column = int(nodeValue(child, F_GRID_PLACED_COL));
            int row = int(nodeValue(child, F_GRID_PLACED_ROW));
            int columnSpan = max(1, int(nodeValue(child, F_GRID_COL_SPAN)));
            int rowSpan = max(1, int(nodeValue(child, F_GRID_ROW_SPAN)));
            float offsetX = 0.0;
            for (int current = 0; current < column && current < columnCount; current++) {
                offsetX += aux[columnBase + current] + columnGap;
            }
            float offsetY = 0.0;
            for (int current = 0; current < row && current < rowCount; current++) {
                offsetY += aux[rowBase + current] + rowGap;
            }
            float trackWidth = columnGap * float(columnSpan - 1);
