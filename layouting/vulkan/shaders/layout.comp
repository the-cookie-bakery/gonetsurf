                    baseCollapsed = collapsedFirst ? 0.0 : marginTop;
                } else {
                    baseCollapsed = collapseMargin(previousMargin, marginTop);
                }
                float childY = cursor + baseCollapsed - marginTop + childCollapseTop;
                bool selfCollapsing = nodeInt(child, F_MODE_H) == 0 && nodeInt(child, F_COUNT) == 0 &&
                    nodeValue(child, F_PT) + nodeValue(child, F_PB) +
                    nodeValue(child, F_BT) + nodeValue(child, F_BB) == 0.0;
                if (selfCollapsing) {
                    float childX = nodeValue(index, F_CX) + nodeValue(child, F_ML);
                    setNodeValue(child, F_X, childX);
                    setNodeValue(child, F_CX, childX + nodeValue(child, F_BL) + nodeValue(child, F_PL));
                    setNodeValue(child, F_Y, childY);
                    setNodeValue(child, F_CY, childY);
                    previousMargin = collapseMargin(baseCollapsed, marginBottom);
                    first = false;
                    child = nodeInt(child, F_NEXT);
                    continue;
                }
                int childWidthMode = nodeInt(child, F_MODE_W);
                if (childWidthMode == 0 || childWidthMode == 2) {
                    float childExtra = nodeValue(child, F_PL) + nodeValue(child, F_PR) +
                        nodeValue(child, F_BL) + nodeValue(child, F_BR);
                    float childContentWidth;
                    if (childWidthMode == 0) {
                        childContentWidth = nodeValue(index, F_CW) - nodeValue(child, F_ML) - nodeValue(child, F_MR) - childExtra;
                    } else {
                        childContentWidth = nodeValue(index, F_CW) * nodeValue(child, F_SPEC_W) * 0.01 +
                            nodeValue(child, F_SPEC_W_OFFSET);
                        if ((nodeFlags(child) & FLAG_BORDER_BOX) != 0) {
                            childContentWidth -= childExtra;
                        }
                    }
                    int childMinMode = nodeInt(child, F_MINW_MODE);
                    if (childMinMode == 0 || childMinMode == 1) {
                        float minimum = childMinMode == 1 ?
                            nodeValue(index, F_CW) * nodeValue(child, F_MIN_W) * 0.01 + nodeValue(child, F_MIN_W_OFFSET) :
                            nodeValue(child, F_MIN_W);
                        childContentWidth = max(childContentWidth, minimum);
                    }
                    int childMaxMode = nodeInt(child, F_MAXW_MODE);
                    if (childMaxMode == 0 || childMaxMode == 1) {
                        float maximum = childMaxMode == 1 ?
                            nodeValue(index, F_CW) * nodeValue(child, F_MAX_W) * 0.01 + nodeValue(child, F_MAX_W_OFFSET) :
                            nodeValue(child, F_MAX_W);
                        childContentWidth = min(childContentWidth, maximum);
                    }
                    childContentWidth = nonNegative(childContentWidth);
                    setNodeValue(child, F_CW, childContentWidth);
                    setNodeValue(child, F_W, childContentWidth + childExtra);
                    setNodeValue(child, F_PARENT_SIZED_W, 1.0);
                }
                float childX = nodeValue(index, F_CX) + nodeValue(child, F_ML);
                setNodeValue(child, F_X, childX);
                setNodeValue(child, F_CX, childX + nodeValue(child, F_BL) + nodeValue(child, F_PL));
                setNodeValue(child, F_Y, childY);
                setNodeValue(child, F_CY, childY + nodeValue(child, F_BT) + nodeValue(child, F_PT));
                bool lastChild = nodeInt(child, F_NEXT) < 0;
                cursor = childY + nodeValue(child, F_H);
                if (lastChild && !collapseLastBottom) {
                    cursor += marginBottom;
                }
                previousMargin = marginBottom;
                first = false;
                child = nodeInt(child, F_NEXT);
            }
            if (nodeInt(index, F_MODE_H) == 0) {
                float contentHeight = nonNegative(cursor - nodeValue(index, F_CY));
                setNodeValue(index, F_CH, contentHeight);
                setNodeValue(index, F_H, contentHeight + verticalExtra);
            }
        } else if ((flags & FLAG_INLINE_CONTAINER) != 0) {
            float contentX = nodeValue(index, F_CX);
            float contentWidth = nodeValue(index, F_CW);
            bool wrap = (nodeFlags(index) & FLAG_NO_WRAP) == 0;
            float lineHeight = nodeValue(index, F_LINE);
            if (lineHeight <= 0.0) {
                lineHeight = 19.2;
            }
            float baseline = nodeValue(index, F_ASCENT);
            int child = nodeInt(index, F_FIRST);
            while (child >= 0) {
                int childFlags = nodeFlags(child);
                if ((childFlags & FLAG_OUT_OF_FLOW) != 0) {
                    child = nodeInt(child, F_NEXT);
                    continue;
                }
                float outerHeight = nodeValue(child, F_MT) + nodeValue(child, F_H) + nodeValue(child, F_MB);
                if (outerHeight > lineHeight) {
                    lineHeight = outerHeight;
                }
                float childAscent = nodeInt(child, F_KIND) == 2 ? nodeValue(child, F_ASCENT) : nodeValue(child, F_H);
                if (int(nodeValue(child, F_VERTICAL_ALIGN)) == 1) {
                    childAscent = nodeValue(child, F_H) * 0.5 + nodeValue(child, F_FONT) * 0.25;
                }
                if (childAscent > baseline) {
                    baseline = childAscent;
                }
                child = nodeInt(child, F_NEXT);
            }
            child = nodeInt(index, F_FIRST);
            while (child >= 0) {
                int childFlags = nodeFlags(child);
                if ((childFlags & FLAG_OUT_OF_FLOW) == 0 &&
                    nodeValue(child, F_ATOMIC_INLINE) > 0.5 &&
                    nodeInt(child, F_MODE_W) == 0) {
                    float childExtra = nodeValue(child, F_PL) + nodeValue(child, F_PR) +
                        nodeValue(child, F_BL) + nodeValue(child, F_BR);
                    float available = nonNegative(contentWidth - nodeValue(child, F_ML) -
                        nodeValue(child, F_MR) - childExtra);
                    float desired = nodeValue(child, F_IMAX);
                    if (desired > available) {
                        desired = available;
                    }
                    if (desired < nodeValue(child, F_IMIN)) {
                        desired = nodeValue(child, F_IMIN);
                    }
                    setNodeValue(child, F_CW, nonNegative(desired));
                    setNodeValue(child, F_W, nonNegative(desired) + childExtra);
                    setNodeValue(child, F_PARENT_SIZED_W, 1.0);
                } else if ((childFlags & FLAG_OUT_OF_FLOW) == 0 &&
                    nodeInt(child, F_KIND) == 1 && nodeValue(child, F_ATOMIC_INLINE) < 0.5 &&
                    nodeInt(child, F_MODE_W) == 0) {
                    float childExtra = nodeValue(child, F_PL) + nodeValue(child, F_PR) +
                        nodeValue(child, F_BL) + nodeValue(child, F_BR);
                    float desired = nodeValue(child, F_IMAX);
                    setNodeValue(child, F_CW, nonNegative(desired));
                    setNodeValue(child, F_W, nonNegative(desired) + childExtra);
                    setNodeValue(child, F_PARENT_SIZED_W, 1.0);
                }
                child = nodeInt(child, F_NEXT);
            }
            float usedWidth = 0.0;
            bool firstRun = true;
            child = nodeInt(index, F_FIRST);
            while (child >= 0) {
                if ((nodeFlags(child) & FLAG_OUT_OF_FLOW) == 0 && nodeValue(child, F_FORCE_BREAK) < 0.5) {
                    if (!firstRun && nodeValue(child, F_SPACE_BEFORE) > 0.5) {
                        usedWidth += nodeValue(child, F_FONT) * 0.25;
                    }
                    usedWidth += nodeValue(child, F_ML) + nodeValue(child, F_W) + nodeValue(child, F_MR);
                    firstRun = false;
                }
                child = nodeInt(child, F_NEXT);
            }
            int textAlign = int(nodeValue(index, F_TEXT_ALIGN));
            float cursorX = contentX;
            float lineY = nodeValue(index, F_CY);
            child = nodeInt(index, F_FIRST);
            bool lineHasContent = false;
            while (child >= 0) {
                int childFlags = nodeFlags(child);
                if ((childFlags & FLAG_OUT_OF_FLOW) != 0) {
                    child = nodeInt(child, F_NEXT);
                    continue;
                }
                if (nodeValue(child, F_FORCE_BREAK) > 0.5) {
                    lineY += lineHeight;
                    lineHasContent = false;
                    child = nodeInt(child, F_NEXT);
                    continue;
                }
                if (!lineHasContent) {
                    float lineWidth = inlineLineWidthFrom(child, contentWidth, wrap);
                    cursorX = contentX + inlineAlignOffset(textAlign, contentWidth, lineWidth);
                }
                float space = 0.0;
                if (lineHasContent && nodeValue(child, F_SPACE_BEFORE) > 0.5) {
                    space = nodeValue(child, F_FONT) * 0.25;
                }
                float childWidth = nodeValue(child, F_W);
                if (wrap && cursorX + space + childWidth > contentX + contentWidth + 6.0 && lineHasContent) {
                    lineY += lineHeight;
                    space = 0.0;
                    lineHasContent = false;
                    float lineWidth = inlineLineWidthFrom(child, contentWidth, wrap);
                    cursorX = contentX + inlineAlignOffset(textAlign, contentWidth, lineWidth);
                }
                cursorX += space;
                int verticalAlign = int(nodeValue(child, F_VERTICAL_ALIGN));
                float childAscent = nodeInt(child, F_KIND) == 2 ? nodeValue(child, F_ASCENT) : nodeValue(child, F_H);
                float childY;
                if (verticalAlign == 1) {
                    childY = lineY + (lineHeight - nodeValue(child, F_H)) * 0.5;
                } else if (verticalAlign == 2) {
                    childY = lineY;
                } else if (verticalAlign == 3) {
                    childY = lineY + lineHeight - nodeValue(child, F_H);
                } else {
                    childY = lineY + baseline - childAscent;
                }
                float childX = cursorX + nodeValue(child, F_ML);
                setNodeValue(child, F_X, childX);
                setNodeValue(child, F_CX, childX + nodeValue(child, F_BL) + nodeValue(child, F_PL));
                setNodeValue(child, F_Y, childY);
                setNodeValue(child, F_CY, childY + nodeValue(child, F_BT) + nodeValue(child, F_PT));
                cursorX += nodeValue(child, F_ML) + childWidth + nodeValue(child, F_MR);
                lineHasContent = true;
                child = nodeInt(child, F_NEXT);
            }
            if (nodeInt(index, F_MODE_H) == 0) {
                float contentHeight = nonNegative(lineY + lineHeight - nodeValue(index, F_CY));
                setNodeValue(index, F_CH, contentHeight);
                setNodeValue(index, F_H, contentHeight + verticalExtra);
            }
        }
        return;
    }

    if (push.mode == 3) {
        int kind = nodeInt(index, F_KIND);
        int layoutFlags = nodeFlags(index);
        if ((layoutFlags & (FLAG_GRID_CONTAINER | FLAG_TABLE_CONTAINER | FLAG_TABLE_ROW | FLAG_TABLE_ROW_GROUP | FLAG_VERTICAL)) != 0) {
            return;
        }
        if (kind == 2 || (layoutFlags & FLAG_REPLACED) != 0) {
            return;
        }
        if (nodeInt(index, F_MODE_H) != 0) {
            return;
        }
        float aspect = nodeValue(index, F_ASPECT);
        if (aspect > 0.0 && nodeValue(index, F_CW) > 0.0) {
            float contentHeight = nodeValue(index, F_CW) / aspect;
            float verticalExtra = nodeValue(index, F_PT) + nodeValue(index, F_PB) +
                nodeValue(index, F_BT) + nodeValue(index, F_BB);
            setNodeValue(index, F_CH, contentHeight);
            setNodeValue(index, F_H, contentHeight + verticalExtra);
            return;
        }
        float verticalExtra = nodeValue(index, F_PT) + nodeValue(index, F_PB) +
            nodeValue(index, F_BT) + nodeValue(index, F_BB);
        if ((layoutFlags & FLAG_FLEX_CONTAINER) != 0) {
            float bottom = nodeValue(index, F_CY);
            int child = nodeInt(index, F_FIRST);
            while (child >= 0) {
                if ((nodeFlags(child) & FLAG_OUT_OF_FLOW) == 0) {
                    bottom = max(bottom, nodeValue(child, F_Y) + nodeValue(child, F_H) + nodeValue(child, F_MB));
                }
                child = nodeInt(child, F_NEXT);
            }
            float contentHeight = nonNegative(bottom - nodeValue(index, F_CY));
            setNodeValue(index, F_CH, contentHeight);
            setNodeValue(index, F_H, contentHeight + verticalExtra);
            return;
        }
        if ((layoutFlags & FLAG_INLINE_CONTAINER) != 0) {
            return;
        }
        if ((layoutFlags & FLAG_BLOCK_CONTAINER) == 0) {
            return;
        }
        bool collapsedFirst = (layoutFlags & FLAG_COLLAPSED_FIRST) != 0;
        bool collapseLastBottom = (layoutFlags & FLAG_BLOCK_FORMATTING) == 0 && !parentFlexOrGrid(index) &&
            nodeValue(index, F_BB) + nodeValue(index, F_PB) == 0.0;
        float cursor = nodeValue(index, F_CY);
        float pendingMargin = 0.0;
        float floatBottom = nodeValue(index, F_CY);
        bool first = true;
        int child = nodeInt(index, F_FIRST);
        while (child >= 0) {
            int childFlags = nodeFlags(child);
            if ((childFlags & FLAG_OUT_OF_FLOW) != 0) {
                child = nodeInt(child, F_NEXT);
                continue;
            }
            if ((childFlags & (FLAG_FLOAT_LEFT | FLAG_FLOAT_RIGHT)) != 0) {
                floatBottom = max(floatBottom, nodeValue(child, F_Y) + nodeValue(child, F_H) + nodeValue(child, F_MB));
                child = nodeInt(child, F_NEXT);
                continue;
            }
            cursor = max(cursor, floatBottom);
            float marginTop = nodeValue(child, F_MT);
            float marginBottom = nodeValue(child, F_MB);
            float baseCollapsed = first ? (collapsedFirst ? 0.0 : marginTop) : collapseMargin(pendingMargin, marginTop);
            bool selfCollapsing = nodeInt(child, F_MODE_H) == 0 && nodeInt(child, F_COUNT) == 0 &&
                nodeValue(child, F_PT) + nodeValue(child, F_PB) +
                nodeValue(child, F_BT) + nodeValue(child, F_BB) == 0.0;
            if (selfCollapsing) {
                pendingMargin = collapseMargin(baseCollapsed, marginBottom);
                first = false;
                child = nodeInt(child, F_NEXT);
                continue;
            }
            cursor = nodeValue(child, F_Y) + nodeValue(child, F_H);
            pendingMargin = marginBottom;
            if (collapseLastBottom && nodeInt(child, F_NEXT) < 0) {
                pendingMargin = 0.0;
            }
            first = false;
            child = nodeInt(child, F_NEXT);
        }
        if (!first) {
            cursor += pendingMargin;
        }
        cursor = max(cursor, floatBottom);
        float contentHeight = nonNegative(cursor - nodeValue(index, F_CY));
        setNodeValue(index, F_CH, contentHeight);
        setNodeValue(index, F_H, contentHeight + verticalExtra);
        return;
    }

    if (push.mode == 14) {
        int flags = nodeFlags(index);
        if ((flags & FLAG_BLOCK_CONTAINER) == 0 || (flags & FLAG_BLOCK_FORMATTING) != 0 || parentFlexOrGrid(index)) {
            return;
        }
        if (nodeInt(index, F_MODE_H) != 0 || nodeValue(index, F_BB) + nodeValue(index, F_PB) != 0.0) {
            return;
        }
        int last = -1;
        int child = nodeInt(index, F_FIRST);
        while (child >= 0) {
            int childFlags = nodeFlags(child);
            if ((childFlags & (FLAG_OUT_OF_FLOW | FLAG_FLOAT_LEFT | FLAG_FLOAT_RIGHT)) == 0) {
                last = child;
            }
            child = nodeInt(child, F_NEXT);
        }
        if (last < 0 || nodeInt(last, F_KIND) != 0) {
            return;
        }
        setNodeValue(index, F_MB, collapseMargin(nodeValue(index, F_ORIG_MB), nodeValue(last, F_MB)));
        return;
    }

    if (push.mode == 4) {
        float contentX = nodeValue(index, F_CX);
        float contentY = nodeValue(index, F_CY);
        float maxRight = contentX + nodeValue(index, F_CW);
        float maxBottom = contentY + nodeValue(index, F_CH);
        int child = nodeInt(index, F_FIRST);
        while (child >= 0) {
            int childFlags = nodeFlags(child);
            float boxRight = nodeValue(child, F_X) + nodeValue(child, F_W);
            float boxBottom = nodeValue(child, F_Y) + nodeValue(child, F_H);
            float childRight = (childFlags & FLAG_CLIP_X) != 0 ?
                boxRight : nodeValue(child, F_CX) + nodeValue(child, F_SCROLL_W);
            float childBottom = (childFlags & FLAG_CLIP_Y) != 0 ?
                boxBottom : nodeValue(child, F_CY) + nodeValue(child, F_SCROLL_H);
            maxRight = max(maxRight, max(boxRight, childRight));
            maxBottom = max(maxBottom, max(boxBottom, childBottom));
            child = nodeInt(child, F_NEXT);
        }
        float scrollWidth = nonNegative(maxRight - contentX);
        float scrollHeight = nonNegative(maxBottom - contentY);
        setNodeValue(index, F_SCROLL_W, scrollWidth);
        setNodeValue(index, F_SCROLL_H, scrollHeight);
        int layoutFlags = nodeFlags(index);
        float scrollFlags = 0.0;
        if ((layoutFlags & FLAG_OVERFLOW_Y) != 0 && scrollHeight > nodeValue(index, F_CH) + 0.5) {
            scrollFlags += 1.0;
        }
        if ((layoutFlags & FLAG_OVERFLOW_X) != 0 && scrollWidth > nodeValue(index, F_CW) + 0.5) {
            scrollFlags += 2.0;
        }
        setNodeValue(index, F_SCROLL_FLAGS, scrollFlags);
        return;
    }
}
